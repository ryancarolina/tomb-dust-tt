{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "python .cursor/hooks/dev_team_user_prompt.py",
        "matcher": "UserPromptSubmit",
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python .cursor/hooks/dev_team_guard.py shell",
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "python .cursor/hooks/dev_team_guard.py file-edit",
        "failClosed": true
      }
    ]
  }
}
