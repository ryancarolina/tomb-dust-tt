{
  "rulesVersion": "1.0.0",
  "procedure": "Roll 1d6 on travel scene in wilderness; on 1, roll encounter table for biome + dangerRating of current AV-GRID cell.",
  "biomes": {
    "HL": {
      "displayName": "Heartland",
      "tables": {
        "hazard": {
          "d6": [
            { "roll": "1-4", "result": "No encounter" },
            { "roll": "5", "result": "1d3 grave-ghoul (hazard) scavenging" },
            { "roll": "6", "result": "1 thornwolf (skirmisher) on King's Road" }
          ]
        },
        "skirmisher": {
          "d6": [
            { "roll": "1-3", "result": "No encounter" },
            { "roll": "4-5", "result": "1d2 thornwolf" },
            { "roll": "6", "result": "1 hollow-knight patrol + 1d4 grave-ghoul" }
          ]
        },
        "elite": {
          "d6": [
            { "roll": "1-2", "result": "No encounter" },
            { "roll": "3-4", "result": "1 ironbound-sentinel (rogue)" },
            { "roll": "5-6", "result": "2 hollow-knight + rust-slime" }
          ]
        }
      }
    },
    "WM": {
