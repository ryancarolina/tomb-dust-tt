{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tomb-dust.local/schemas/faction-registry.json",
  "title": "Tomb Dust faction reputation registry",
  "type": "object",
  "required": ["rulesVersion", "factions"],
  "properties": {
    "rulesVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "factions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/faction" }
    }
  },
  "$defs": {
    "faction": {
      "type": "object",
      "required": ["id", "displayName", "repMin", "repMax", "tiers"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/slug" },
        "displayName": { "type": "string", "minLength": 1 },
        "repMin": { "type": "integer" },
        "repMax": { "type": "integer" },
        "hubAddresses": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "docPath": { "type": "string" },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tier" }
        }
      }
    },
    "tier": {
      "type": "object",
      "required": ["rep", "label"],
      "properties": {
        "rep": { "type": "integer" },
        "repOp": { "type": "string", "enum": ["eq", "lte", "gte"] },
        "label": { "type": "string", "minLength": 1 },
        "effects": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mechanicalKeys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
