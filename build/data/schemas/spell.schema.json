{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tomb-dust.local/schemas/spell.json",
  "title": "Tomb Dust Spell",
  "type": "object",
  "required": ["id", "rulesVersion", "displayName", "school", "tier", "mpCost", "castingTime", "range", "effectType"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "rulesVersion": { "$ref": "common.schema.json#/$defs/rulesVersion" },
    "displayName": { "type": "string", "minLength": 1 },
    "docPath": { "$ref": "common.schema.json#/$defs/markdownPath" },
    "school": { "$ref": "common.schema.json#/$defs/slug" },
    "tradition": { "type": "string", "enum": ["arcane", "divine"] },
    "tier": { "type": "integer", "minimum": 1, "maximum": 6 },
    "mpCost": { "type": "integer", "minimum": 0 },
    "castingTime": { "type": "string", "minLength": 1 },
    "range": { "type": "string", "minLength": 1 },
    "duration": { "type": "string" },
    "concentration": { "type": "boolean" },
    "effectType": {
      "type": "string",
      "enum": ["attack", "save", "heal", "buff", "utility", "summon", "counter", "terrain"]
    },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "damage": { "$ref": "common.schema.json#/$defs/diceNotation" },
        "damageType": { "type": "string" }
      }
    },
    "save": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ability"],
      "properties": {
        "ability": { "type": "string", "enum": ["STR", "AGI", "STA", "INT", "SPI"] }
      }
    },
    "damage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dice": { "$ref": "common.schema.json#/$defs/diceNotation" },
        "damageType": { "type": "string" },
        "halfOnSave": { "type": "boolean" }
      }
    },
    "heal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dice": { "$ref": "common.schema.json#/$defs/diceNotation" },
        "addAbility": { "type": "string", "enum": ["INT", "SPI", "none"] }
      }
    },
    "summon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monsterId": { "$ref": "common.schema.json#/$defs/slug" },
        "count": { "type": "integer", "minimum": 1 },
        "tier": { "type": "string" }
      }
    },
    "effect": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "onSaveFail": { "type": "boolean" }
        }
      }
    }
  },
  "anyOf": [
    { "required": ["attack"] },
    { "required": ["save"] },
    { "required": ["heal"] },
    { "required": ["effect"] },
    { "required": ["summon"] }
  ]
}
